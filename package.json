{
  "name": "todoapp",
  "version": "1.0.0",
  "author": "Berke",
  "description": "Electron + React + TypeScript Task Manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"npm run dev:renderer\" \"npm run build:electron && wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:renderer && npm run build:electron && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.todoapp.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@esbuild/linux-x64": "^0.28.0",
    "@rollup/rollup-linux-x64-gnu": "^4.60.4",
    "better-sqlite3": "^12.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "34.0.0",
    "electron-builder": "^24.13.3",
    "happy-dom": "^20.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  }
}
